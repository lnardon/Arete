# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=60

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=arete_dev
# Set to "require" or "verify-full" in production
DB_SSLMODE=disable

# JWT
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24

# App
# Set to the public URL of your frontend in production (e.g. https://yourdomain.com)
APP_DOMAIN=http://localhost:5173
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
ENV=development
# IANA timezone the WhatsApp assistant uses to resolve "today" (must match
# your users' local timezone, or habit/goal dates recorded via WhatsApp can
# land on the wrong day relative to the web UI, which uses the browser's
# local time).
APP_TIMEZONE=America/Sao_Paulo

# Evolution API (WhatsApp gateway) — see docker-compose.yml for the self-hosted service
EVOLUTION_API_BASE_URL=http://localhost:8081
EVOLUTION_API_KEY=replace-with-a-random-secret
EVOLUTION_INSTANCE_NAME=arete
EVOLUTION_WEBHOOK_SECRET=replace-this-with-a-random-secret

# OpenAI (AI assistant)
OPENAI_API_KEY=replace-with-your-openai-api-key
# gpt-5.6-luna is the cheapest current tier and still supports full tool use —
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Google Calendar sync
# Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the Calendar API, and register GOOGLE_REDIRECT_URL below as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/google/callback
# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts stored Google access/refresh tokens at rest.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-base64-key
# How often the background sync engine polls connected accounts.
GOOGLE_SYNC_INTERVAL_MINUTES=5
